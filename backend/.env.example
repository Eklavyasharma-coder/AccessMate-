PORT=5000
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:5500
# In production, set exact deployed frontend URL (comma-separated for multiple).
TRUST_PROXY=false

# Rate limits (requests per window)
AUTH_RATE_LIMIT_MAX=20
AI_RATE_LIMIT_MAX=10

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=your_postgres_user
DB_PASSWORD=replace_with_database_password
DB_NAME=accessmate
DB_SSL=false
# Set DB_SSL=true in production with a managed PostgreSQL host.

# JWT — access token (short-lived) + refresh token (long-lived)
JWT_SECRET=replace_with_at_least_32_random_bytes
JWT_EXPIRES_IN=15m
REFRESH_SECRET=replace_with_a_different_32_byte_secret
REFRESH_EXPIRES_IN=7d

# File uploads
MAX_FILE_SIZE_MB=10
UPLOAD_DIR=./uploads
OCR_TIMEOUT_MS=60000

# AI provider (OpenAI-compatible) — leave blank to disable AI safely
AI_API_URL=https://api.openai.com/v1/chat/completions
AI_API_KEY=
AI_MODEL=

# Email (Nodemailer) — leave blank to disable password reset emails
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=noreply@example.com
EMAIL_PASS=replace_with_smtp_password
EMAIL_FROM=AccessMate <noreply@example.com>
APP_BASE_URL=http://localhost:5500

# Super Admin bootstrap — ONE-TIME USE ONLY.
# After running: node scripts/bootstrap-superadmin.js
# Delete these lines from .env immediately.
BOOTSTRAP_SUPER_ADMIN_EMAIL=
BOOTSTRAP_SUPER_ADMIN_PASSWORD=
