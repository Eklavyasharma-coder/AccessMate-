{
  "name": "accessmate-backend",
  "version": "1.8.0",
  "private": true,
  "description": "Modular Express API for AccessMate AI — Stage 8",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "check": "node --check server.js && node --check src/app.js",
    "test": "node --test tests/*.test.js",
    "db:check": "node scripts/check-schema.js",
    "db:migrate": "node scripts/migrate.js",
    "smoke": "node scripts/smoke-test.js",
    "bootstrap": "node scripts/bootstrap-superadmin.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^10.2.1",
    "pg": "^8.23.1",
    "tesseract.js": "^5.1.1",
    "uuid": "^11.1.0"
  }
}
